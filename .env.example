# Copia questo file in .env (già escluso da git) e inserisci i tuoi valori.
# Le variabili d'ambiente già impostate nel sistema hanno la precedenza sul file .env.

# --- Obbligatorie ------------------------------------------------------------

# URL base dell'API OpenAI-compatible, comprensivo di /v1.
LOCAL_LLM_BASE_URL=https://api.ai.itsincom.org/v1

# API key (sk-...). Non committarla mai.
LOCAL_LLM_API_KEY=

# --- Modello ------------------------------------------------------------------

# Modello di tutti i tool. Deve supportare tools, response_format e reasoning_effort
# (`uv run local-llm-mcp --check` lo verifica).
LOCAL_LLM_MODEL=glm-5.3-flash
# reasoning_effort usato dai tool che non hanno un default proprio: low, medium, high.
# Ogni tool accetta anche il parametro 'effort'. high è molto più lento (vedi README).
LOCAL_LLM_DEFAULT_EFFORT=medium
# Formato JSON chiesto a ogni passo dell'esplorazione (true) o solo alla fine (false).
# Vuoto = true per i modelli glm-*, false per gli altri (alcuni, con il formato attivo,
# rispondono senza leggere il progetto). Vedi README, "Se GLM non è più disponibile".
LOCAL_LLM_JSON_WHILE_EXPLORING=

# Tier per richiesta (header X-Siati-Tier): slow, medium, fast, ludicrous.
# Vuoto = tier predefinito della chiave.
LOCAL_LLM_TIER=

# --- Limiti dell'agente -------------------------------------------------------

# I tool con 'root' fanno esplorare il progetto a GLM in sola lettura. Raggiunto uno di questi
# limiti, GLM deve rispondere con quello che ha letto e il risultato riporta "stopped".
# Richieste al modello per compito.
LOCAL_LLM_AGENT_MAX_STEPS=25
# Caratteri di file letti in tutto il compito.
LOCAL_LLM_AGENT_MAX_READ_CHARS=200000
# Secondi di esplorazione. La risposta finale ha al massimo LOCAL_LLM_TIMEOUT_SECONDS in più:
# un tool dura quindi al massimo la somma dei due.
LOCAL_LLM_TASK_TIMEOUT_SECONDS=300

# --- Limiti delle richieste ---------------------------------------------------

# Secondi di attesa massima per una singola risposta. GLM ragiona sempre: con effort high una
# risposta lunga può superare i 2 minuti.
LOCAL_LLM_TIMEOUT_SECONDS=120
# Tentativi aggiuntivi su 429, 502, 503 temporanei ed errori di connessione (mai sui timeout).
LOCAL_LLM_MAX_RETRIES=2
# Token generati per risposta, ragionamento compreso (da 1024 a 32768, il massimo dell'API).
# Valori bassi troncano propose_change e critique_plan.
LOCAL_LLM_GLM_MAX_OUTPUT_TOKENS=32768
# Caratteri massimi di documenti, diff, piani e file passati con 'path'/'paths'.
LOCAL_LLM_DOCUMENT_MAX_CHARS=600000

# --- Accesso ai file (sola lettura) ------------------------------------------

# Cartelle da cui i tool possono leggere: 'root' dei progetti e 'path'/'paths' dei file.
# Più cartelle separate da ';' su Windows (':' su Linux/macOS). Vuoto = lettura disattivata.
# File come .env, chiavi, certificati e la cartella .git restano sempre esclusi.
# Claude salva le diff da passare a review_changes in un file: aggiungi anche una cartella per
# i file temporanei, fuori dai repository (vedi README, "Dove salvare le diff").
# Esempio Windows: LOCAL_LLM_ALLOWED_READ_ROOTS=D:\progetti
LOCAL_LLM_ALLOWED_READ_ROOTS=

# --- Log ----------------------------------------------------------------------

# DEBUG, INFO, WARNING, ERROR. I log vanno su stderr e contengono solo metadati.
LOCAL_LLM_LOG_LEVEL=INFO

# --- Registro delle chiamate (dashboard) ---------------------------------------

# File SQLite con i metadati di ogni chiamata (mai il contenuto), letto da `local-llm-dashboard`.
# Vuoto = <repo>/.local/calls.sqlite3 (escluso da git). Percorso assoluto, oppure off.
LOCAL_LLM_CALL_LOG=
# Giorni di storico conservati.
LOCAL_LLM_CALL_LOG_DAYS=30

# --- Variabili non più usate --------------------------------------------------
# LOCAL_LLM_DEFAULT_MODEL, LOCAL_LLM_CODE_MODEL, LOCAL_LLM_EXCLUDED_MODELS, LOCAL_LLM_MAX_CHUNKS,
# LOCAL_LLM_REVIEW_CHUNK_CHARS, LOCAL_LLM_MAX_PROMPT_CHARS, LOCAL_LLM_MAX_INPUT_CHARS e
# LOCAL_LLM_MAX_OUTPUT_TOKENS appartenevano ai tool per i modelli piccoli: se restano nel .env
# vengono ignorate e `--check` le elenca.
